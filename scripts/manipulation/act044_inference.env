# Today's LeRobot 0.4.4 checkpoints only. Older 0.6.1 runs are rejected.
ACT044_RUN_DIR="$HOME/omx_sim_runs/retraining_044_20261026"

# Inference defaults; explicit command-line options override these values.
ACT044_DURATION=10
ACT044_ACTION_STEPS=5
# To enable temporal ensembling, set ACTION_STEPS=1 and TEMPORAL_ENSEMBLE=true.
ACT044_TEMPORAL_ENSEMBLE=false
ACT044_TEMPORAL_ENSEMBLE_COEFF=0.01
ACT044_MAX_RELATIVE_TARGET=3
ACT044_DEVICE=cuda
ACT044_DISPLAY=false

# Device paths copied from the existing local setup. The old bundle config.env
# is not sourced by this launcher; edit device and inference settings here.
ROBOT_ID=omx_follower_arm
ROBOT_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_77AABA9150323952582E3120FF06102E-if00
FRONT_CAM=/dev/v4l/by-id/usb-Jieli_Technology_USB_Composite_Device-video-index0
WRIST_CAM=/dev/v4l/by-id/usb-Innomaker_Innomaker-U20CAM-720P_SN0001-video-index0
FRONT_CAM_FPS=22
WRIST_CAM_FPS=30
FRONT_CAM_FOURCC=
WRIST_CAM_FOURCC=
TASK="상자를 짚어서 흰 바구니 안에 넣는다."
