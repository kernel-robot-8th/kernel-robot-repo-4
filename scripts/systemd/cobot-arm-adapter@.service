# Station PC: 팔 한 대의 어댑터 노드를 계속 띄워 둔다. 사용자 서비스 (sudo 없음).
# 템플릿이다. @ 뒤가 팔 이름(%i)이 된다: cobot-arm-adapter@omx2 → run_arm_adapter.sh --arm omx2
# 한 PC 에 팔이 둘이면 팔마다 하나씩 켠다 (예: 8-OMEN = omx1·omx2).
# 설정은 station.env 하나: 이 PC 팔(COBOT_ARMS), 실제로 돌릴 팔(COBOT_WORKER_ARMS, 나머지는 none), 실행기 경로.
# 노드는 꺼짐(DISARMED)으로 시작한다. worker 면 관제 '켜기'(START)를 받아야 실제 팔에 토크가 켜진다.
# none 이면 켜기·작업을 모두 거절한다 (토크가 켜지지 않음).
# 팔 옆에 사람이 없으면 끈다: systemctl --user stop 'cobot-arm-adapter@*'
# 설치: scripts/systemd/install_station_services.sh (@REPO@ 를 저장소 경로로 바꿔 복사한다)
# 설명서: docs/station_pc_services.md

[Unit]
Description=cobot Station PC arm adapter (%i)
After=network-online.target
# 실행기가 포트를 잡고 있는 등 사전 검사 실패가 반복되면 재시작을 멈춘다
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=%h/.config/cobot/station.env
ExecStart=@REPO@/scripts/run_arm_adapter.sh --arm %i --domain ${ROS_DOMAIN_ID} --backend auto
Restart=on-failure
RestartSec=5
# 터미널 Ctrl+C 와 같은 경로로 끈다 (켜져 있던 팔은 토크 해제, release_timeout 5 s)
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
