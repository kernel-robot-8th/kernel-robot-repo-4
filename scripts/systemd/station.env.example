# Station PC 서비스 환경 파일 예시. install_station_services.sh 가 ~/.config/cobot/station.env 로 복사한다.
# 실제 값 파일(~/.config/cobot/station.env)은 커밋하지 않는다 (CLAUDE.md §9).
# systemd 는 ~/.bashrc 를 읽지 않으므로 ROS 통신 설정을 여기에 다시 적는다.
# 이 파일에서는 $HOME·~ 가 풀리지 않는다. 경로는 절대 경로로 쓴다 (@HOME@ 은 설치 때 바뀐다).

# 관제 PC 와 같은 도메인. 지금 쓰는 값을 그대로 옮긴다 (임의로 바꾸지 않는다, D2)
ROS_DOMAIN_ID=100
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file://@HOME@/.ros/cyclonedds_pc.xml

# 이 PC 자리 팔 목록 (공백으로 구분). cobot_control_center/config/site_arms.yaml 에서 host 가 이 PC 인 팔.
# 예: OMEN-11 = "omx3", 8-OMEN = "omx1 omx2". 설치 스크립트 --enable 이 팔마다 cobot-arm-adapter@<팔> 을 등록한다.
# 보드 시리얼이 아직 없는 팔은 빼 둔다 (노드가 떠도 UNKNOWN 으로 일을 안 한다).
COBOT_ARMS="omx2"
# 위 팔 중 실제로 돌릴 팔 (backend worker: 관제 '켜기'로 토크가 켜지고 작업하면 팔이 움직인다).
# 여기 없는 팔은 none: 켜기·작업을 모두 거절하고 상태만 보고한다.
# worker 는 그 팔 칸이 실행기 fleet_arms.yaml 의 arms.<팔 이름> 에 있을 때만 넣는다.
# 바꾼 뒤에는 그 팔만 다시 켠다: systemctl --user restart cobot-arm-adapter@<팔>
COBOT_WORKER_ARMS=""

# 팔 실행기 (run_arm_adapter.sh 가 읽는다, worker 일 때만)
# 실행기 폴더. 비우면 저장소 옆 worktree <저장소>-omx-dashboard/omx_fleet
OMX_FLEET_DIR=
OMX_VENV_PY=@HOME@/venv/il/bin/python

# 실행기 CPU 스레드 제한. torch·OpenCV 는 기본으로 프로세스마다 코어 수만큼 스레드를 띄운다.
# 한 PC 에 팔이 둘이면 두 실행기가 CPU 를 서로 빼앗아 느려진다
# (2026-11-21 8-OMEN 24코어: 혼자 15~20 스텝/s → 둘이 같이 6.5 스텝/s, 목표 30).
# 팔이 하나뿐인 PC 도 그대로 둬도 된다. 값은 docs/station_pc_services.md '주의' 참고.
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
OPENCV_FOR_THREADS_NUM=4

# 부팅 때 DDS 인터페이스(CYCLONEDDS_URI 의 NetworkInterface) 주소를 기다리는 최대 초 (wait_for_dds_iface.sh).
# 비우면 60
# COBOT_NET_WAIT_SEC=60
