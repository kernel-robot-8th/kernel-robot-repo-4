#
# Station PC: PC 상태 보고 노드(host_status_node)를 계속 띄워 둔다. 사용자 서비스 (sudo 없음).
# 읽기만 한다 (/proc, /sys, ip·nmcli). 로봇·팔에 명령을 내지 않는다.
# 설치: scripts/systemd/install_station_services.sh (@REPO@ 를 저장소 경로로 바꿔 복사한다)
# 설명서: docs/station_pc_services.md

[Unit]
Description=cobot Station PC host status report
# 사용자 서비스에는 network-online.target 이 없어 After= 로 순서를 맞출 수 없다.
# 대신 ExecStartPre 가 DDS 인터페이스(Wi-Fi) 주소가 생길 때까지 기다린다.

[Service]
Type=simple
EnvironmentFile=%h/.config/cobot/station.env
ExecStartPre=@REPO@/scripts/systemd/wait_for_dds_iface.sh
TimeoutStartSec=90
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source @REPO@/install/setup.bash && exec ros2 launch cobot_control_center host_status.launch.xml host:=station'
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=default.target
