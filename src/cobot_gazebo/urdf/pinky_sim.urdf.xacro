<?xml version="1.0"?>
<!--
  Copyright 2026 Pinky_Team4
  Licensed under the Apache License, Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0).

  시뮬용 단순 핑키 (차동구동 + 2D 라이다). 실물 메시는 쓰지 않는다.
  프레임 이름은 실물 Nav2 파라미터(config/nav2_sim.yaml)와 같다: base_footprint / base_link / laser.
  크기는 Nav2 footprint(0.12 m 정사각형)에 맞췄다.
  robot_name 은 가제보 토픽 접두사(/model/<robot_name>/...)로만 쓰고, ROS 쪽 이름은 ros_gz_bridge 가 바꾼다.
-->
<robot name="pinky_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_name" default="pinky1"/>
  <xacro:property name="robot_name" value="$(arg robot_name)"/>

  <xacro:property name="wheel_radius" value="0.022"/>     <!-- [m] -->
  <xacro:property name="wheel_width" value="0.012"/>      <!-- [m] -->
  <xacro:property name="wheel_separation" value="0.100"/> <!-- [m] 바퀴 중심 사이 -->
  <xacro:property name="body_size" value="0.110"/>        <!-- [m] 몸체 가로·세로 -->
  <xacro:property name="body_bottom" value="0.012"/>      <!-- [m] 바닥에서 몸체 아래면 -->
  <xacro:property name="body_top" value="0.100"/>         <!-- [m] 바닥에서 몸체 윗면 -->
  <xacro:property name="caster_radius" value="0.011"/>    <!-- [m] -->
  <xacro:property name="lidar_z" value="0.115"/>          <!-- [m] 라이다 광원 높이 (다른 핑키의 라이다 원통과 같은 높이) -->
  <xacro:property name="body_color" value="0.95 0.45 0.65 1"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m * (y * y + z * z) / 12}" ixy="0" ixz="0"
             iyy="${m * (x * x + z * z) / 12}" iyz="0" izz="${m * (x * x + y * y) / 12}"/>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${(body_bottom + body_top) / 2}"/>
      <geometry><box size="${body_size} ${body_size} ${body_top - body_bottom}"/></geometry>
      <material name="pinky"><color rgba="${body_color}"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${(body_bottom + body_top) / 2}"/>
      <geometry><box size="${body_size} ${body_size} ${body_top - body_bottom}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${(body_bottom + body_top) / 2}"/>
      <mass value="0.8"/>
      <xacro:box_inertia m="0.8" x="${body_size}" y="${body_size}" z="${body_top - body_bottom}"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1.2e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel">
      <collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation / 2}"/>
  <xacro:wheel side="right" y="${-wheel_separation / 2}"/>

  <!-- 앞뒤 캐스터: 마찰 0 인 고정 구 (몸체가 앞뒤로 기울지 않게) -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
      <visual><geometry><sphere radius="${caster_radius}"/></geometry></visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${x} 0 ${caster_radius}"/>
    </joint>
    <gazebo reference="${name}_caster">
      <collision><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
    </gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="0.042"/>
  <xacro:caster name="rear" x="-0.042"/>

  <!-- 라이다 (RPLIDAR C1 자리). 원통은 다른 핑키의 라이다에 보이도록 광원과 같은 높이에 둔다 -->
  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.035" length="0.030"/></geometry>
      <material name="lidar"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.035" length="0.030"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0 0 ${lidar_z}"/>
  </joint>

  <gazebo reference="laser">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/model/${robot_name}/scan</topic>
      <gz_frame_id>laser</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <!-- min 0.1 m: 자기 라이다 원통(반지름 0.035 m)은 걸러진다 -->
        <range>
          <min>0.10</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/model/${robot_name}/cmd_vel</topic>
      <odom_topic>/model/${robot_name}/odom</odom_topic>
      <tf_topic>/model/${robot_name}/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/${robot_name}/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
