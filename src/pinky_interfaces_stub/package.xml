<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pinky_interfaces</name>
  <version>0.0.0</version>
  <description>시뮬 PC 전용 대체 패키지. 순찰 노드가 import 하는 pinky_interfaces/srv/SetLed 만 둔다 (실물 패키지는 로봇에만 설치되어 있고 이 저장소에 없음). 실물 로봇 워크스페이스에서는 빌드하지 않는다. cobot_gazebo 만 이 패키지를 쓴다.</description>
  <maintainer email="bebe217@gmail.com">jihye kim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
