# /etc/cobot/robot.env 로 복사해 로봇마다 고친다. 경로는 2026-11-12 pinky3 실물에서 확인한 값이다.
# systemd EnvironmentFile 형식: KEY=VALUE, 셸 확장 없음.
# WORKSPACE·UNDERLAY_SETUPS 는 bash 가 따옴표 안에서 source 하므로 ~ 대신 절대 경로로 쓴다.
# MAP 의 ~ 는 robot_startup 이 HOME 기준으로 푼다.

# pinky1 / pinky2 / pinky3
ROBOT_ID=pinky1
# pinky1=10, pinky2=20, pinky3=30
DOMAIN_ID=10
WORKSPACE=/home/pinky/ws/kernel-robot-repo-4
MAP=~/cobot_map_v9.yaml
SITE=lab
# 제조사 기본 패키지(pinky_bringup·pinky_navigation·pinky_led) workspace. 띄어쓰기로 여러 개.
# .bashrc 는 systemd 가 읽지 않으므로 여기 적어야 찾을 수 있다.
UNDERLAY_SETUPS=/home/pinky/pinky_pro/install/setup.bash

# 장비의 DDS 설정이 필요하면 여기에 추가한다 (예: RMW_IMPLEMENTATION=...). 노드에 그대로 전달된다.
