<launch>
  <!-- 기존 실행 명령 호환용. 모든 로봇은 공통 launch를 사용한다. -->
  <arg name="site" default="lab"/>
  <arg name="start_led" default="false"/>
  <include file="$(find-pkg-share cobot_pinky_patrol)/launch/patrol.launch.xml">
    <arg name="robot_id" value="pinky2"/>
    <arg name="site" value="$(var site)"/>
    <arg name="start_led" value="$(var start_led)"/>
  </include>
</launch>
