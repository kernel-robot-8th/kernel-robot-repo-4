<launch>
  <arg name="patrol_config_dir" default=""/>
  <arg name="site" default="lab"/>
  <!-- 관제 PC의 기존 도메인 100에서 실행한다. -->
  <node pkg="cobot_fleet_control" exec="fleet_control_node" name="fleet_control" output="screen">
    <param from="$(find-pkg-share cobot_fleet_control)/config/fleet_control.yaml"/>
    <param name="patrol_config_dir" value="$(var patrol_config_dir)" type="str"/>
    <param name="site" value="$(var site)" type="str"/>
  </node>
</launch>
