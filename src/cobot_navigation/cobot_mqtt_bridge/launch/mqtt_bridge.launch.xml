<launch>
  <!-- MQTT 브릿지를 관제 PC 에서 한 줄로 켠다. 관제 쪽 노드는 이 PC 에서, 로봇 쪽 노드는 ssh 로 pinky1 에서 켠다.
       ros2 launch cobot_mqtt_bridge mqtt_bridge.launch.xml mode:=read   값 보기 (로봇은 움직이지 않음)
       ros2 launch cobot_mqtt_bridge mqtt_bridge.launch.xml mode:=cmd    명령 모드 (patrol_cmd 만 열림, 로봇이 움직일 수 있음)
       Ctrl+C 한 번으로 양쪽이 같이 꺼진다. 관제 도메인(pc_domain)과 DDS 설정은 이 파일 안에서 정한다.
       cobot_domain_bridge 와 같은 도메인에서 동시에 켜지 않는다(이중 발행 방지). 로봇 쪽 서비스 mqtt_bridge_robot 이
       켜져 있으면 접속이 서로 끊기므로 로봇 쪽 노드가 시작하지 않고 이유를 출력한다. -->
  <arg name="mode" default="read" description="read: 값 보기, cmd: 명령 모드(로봇이 움직일 수 있음)"/>
  <arg name="pinky1" default="true" description="pinky1 MQTT 브릿지 실행 여부"/>
  <arg name="pinky2" default="false" description="pinky2 MQTT 브릿지 실행 여부 (관제 쪽만, 로봇 쪽은 직접)"/>
  <arg name="pinky3" default="false" description="pinky3 MQTT 브릿지 실행 여부 (관제 쪽만, 로봇 쪽은 직접)"/>
  <arg name="params_file" default="$(find-pkg-share cobot_mqtt_bridge)/config/mqtt_bridge.yaml"
       description="MQTT 브릿지 파라미터 YAML"/>
  <arg name="down_params_file" default="$(find-pkg-share cobot_mqtt_bridge)/config/mqtt_down.yaml"
       description="cmd 모드의 열 명령·보호 값 YAML"/>
  <arg name="host" default="127.0.0.1" description="MQTT 브로커 주소"/>
  <arg name="port" default="1883" description="MQTT 브로커 포트"/>
  <arg name="enable_down" default="false" description="관제→로봇(명령) 중계 사용 여부 (mode:=cmd 이면 자동으로 켜짐)"/>
  <arg name="duration_sec" default="0.0" description="실행 시간 [s], 0 이면 계속"/>
  <arg name="pc_domain" default="200" description="관제 쪽 ROS 도메인 (시험은 102)"/>
  <arg name="robot_domain" default="10" description="로봇 쪽 ROS 도메인"/>
  <arg name="cyclonedds_uri" default="file://$(env HOME)/.ros/cyclonedds_pc.xml" description="관제 쪽 CycloneDDS 설정"/>
  <arg name="robot_remote" default="true" description="ssh 로 pinky1 의 로봇 쪽 노드도 켤지 여부"/>
  <arg name="robot_host" default="pinky@192.168.45.21" description="로봇 쪽 ssh 주소"/>
  <arg name="confirm_real_domain" default="unset"
       description="실제 도메인 확인 값. unset 이면 pc_domain 값을 쓴다"/>

  <let name="is_cmd" value="$(eval &quot;'$(var mode)' == 'cmd'&quot;)"/>
  <let name="down_on" value="$(eval &quot;'true' if ('$(var mode)' == 'cmd' or '$(var enable_down)' == 'true') else 'false'&quot;)"/>
  <let name="confirm" value="$(eval &quot;'$(var pc_domain)' if '$(var confirm_real_domain)' == 'unset' else '$(var confirm_real_domain)'&quot;)"/>
  <let name="down_params" value="$(eval &quot;'$(var down_params_file)' if '$(var mode)' == 'cmd' else '$(var params_file)'&quot;)"/>
  <let name="robot_extra" value="$(eval &quot;'--params-file /home/pinky/mqtt_bridge/cobot_mqtt_bridge/config/mqtt_down.yaml -p enable_down:=true -p confirm_real_domain:=$(var robot_domain)' if '$(var mode)' == 'cmd' else ''&quot;)"/>

  <set_env name="ROS_DOMAIN_ID" value="$(var pc_domain)"/>
  <set_env name="CYCLONEDDS_URI" value="$(var cyclonedds_uri)"/>

  <executable cmd="echo [mqtt_bridge] mode=$(var mode) 관제 도메인=$(var pc_domain) 로봇 도메인=$(var robot_domain) (cmd 이면 로봇이 움직일 수 있다)" output="screen" shell="false"/>

  <node pkg="cobot_mqtt_bridge" exec="mqtt_bridge_node" name="mqtt_bridge_pinky1"
        output="screen" if="$(var pinky1)">
    <param from="$(var params_file)"/>
    <param from="$(var down_params)"/>
    <param name="robot" value="pinky1"/>
    <param name="side" value="pc"/>
    <param name="host" value="$(var host)"/>
    <param name="port" value="$(var port)"/>
    <param name="enable_down" value="$(var down_on)"/>
    <param name="duration_sec" value="$(var duration_sec)"/>
    <param name="confirm_real_domain" value="$(var confirm)"/>
    <param name="exit_on_parent_loss" value="true"/>
  </node>

  <node pkg="cobot_mqtt_bridge" exec="mqtt_bridge_node" name="mqtt_bridge_pinky2"
        output="screen" if="$(var pinky2)">
    <param from="$(var params_file)"/>
    <param from="$(var down_params)"/>
    <param name="robot" value="pinky2"/>
    <param name="side" value="pc"/>
    <param name="host" value="$(var host)"/>
    <param name="port" value="$(var port)"/>
    <param name="enable_down" value="$(var down_on)"/>
    <param name="duration_sec" value="$(var duration_sec)"/>
    <param name="confirm_real_domain" value="$(var confirm)"/>
    <param name="exit_on_parent_loss" value="true"/>
  </node>

  <node pkg="cobot_mqtt_bridge" exec="mqtt_bridge_node" name="mqtt_bridge_pinky3"
        output="screen" if="$(var pinky3)">
    <param from="$(var params_file)"/>
    <param from="$(var down_params)"/>
    <param name="robot" value="pinky3"/>
    <param name="side" value="pc"/>
    <param name="host" value="$(var host)"/>
    <param name="port" value="$(var port)"/>
    <param name="enable_down" value="$(var down_on)"/>
    <param name="duration_sec" value="$(var duration_sec)"/>
    <param name="confirm_real_domain" value="$(var confirm)"/>
    <param name="exit_on_parent_loss" value="true"/>
  </node>

  <!-- 로봇 쪽(pinky1): ssh -tt 라서 이 launch 를 Ctrl+C 로 끄면 로봇 쪽 노드도 같이 끝난다.
       서비스 mqtt_bridge_robot 이 켜져 있으면 시작하지 않는다. 코드는 ~/mqtt_bridge 에 복사해 둔 것을 쓴다(빌드 불필요).
       원격 명령은 <let> 으로 따로 두어 ssh 에 한 인자로 넘긴다(cmd 속성은 치환마다 따로 쪼개져 따옴표를 걸칠 수 없다). -->
  <let name="robot_script" value="systemctl is-active --quiet mqtt_bridge_robot &amp;&amp; { echo &quot;[mqtt_bridge] mqtt_bridge_robot 서비스가 켜져 있어 로봇 쪽을 시작하지 않는다: sudo systemctl stop mqtt_bridge_robot&quot;; exit 3; }; source /opt/ros/jazzy/setup.bash; export ROS_DOMAIN_ID=$(var robot_domain) RMW_IMPLEMENTATION=rmw_cyclonedds_cpp CYCLONEDDS_URI=file:///home/pinky/.ros/cyclonedds_robot.xml PYTHONPATH=/home/pinky/mqtt_bridge/cobot_mqtt_bridge:$PYTHONPATH; exec python3 -m cobot_mqtt_bridge.mqtt_bridge_node --ros-args --params-file /home/pinky/mqtt_bridge/cobot_mqtt_bridge/config/mqtt_bridge.yaml $(var robot_extra) -p robot:=pinky1 -p side:=robot -p bridge_config:=/home/pinky/mqtt_bridge/cobot_mqtt_bridge/config/mqtt_topics_pinky1.yaml -p duration_sec:=$(var duration_sec) -r __node:=mqtt_bridge_pinky1_robot"/>
  <executable cmd="ssh -tt -o BatchMode=yes -o ServerAliveInterval=10 -o ServerAliveCountMax=3 $(var robot_host) $(var robot_script)"
              output="screen" shell="false" if="$(eval &quot;'$(var robot_remote)' == 'true' and '$(var pinky1)' == 'true'&quot;)"/>
</launch>
