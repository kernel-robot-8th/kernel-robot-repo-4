  Licensed under the Apache License, Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0).

  관제 백엔드 (FastAPI). /control_center/fleet_status 를 받아 HTTP·WebSocket 으로 내고 화면을 띄운다.
  fastapi·uvicorn 이 필요하다 (.venv 를 켠 셸에서 빌드·실행, CLAUDE.md §5).
    화면 /   API /api/health, /api/fleet, /api/robots, /api/robots/{robot_id}, /api/map/info, /api/map/image,
      /api/map/layers, /api/arms, POST /api/arms/{arm_id}/command
    WS /ws/fleet

  map_yaml 기본값은 로봇이 쓰는 지도(cobot_navigation/map_view_pc/maps/cobot_map_v9)다.
  colcon 표준 배치(<ws>/install/<pkg>/share/<pkg>)에서 <ws>/src 로 거슬러 올라간다.
  다른 지도나 배치면 map_yaml:=<경로> 로 바꾼다.
  host 기본값 127.0.0.1 은 이 PC 에서만 열린다. 내부망 다른 PC 에서 보려면 host:=0.0.0.0
  (로그인 기능이 없어 같은 망 누구나 명령 버튼을 누를 수 있다. 방화벽에서 포트도 열어야 한다).
  port 는 실물(8080)과 가짜 핑키(cobot_mock, 8081)를 한 PC 에서 함께 띄울 때 겹치지 않게 나눈다.
  구역 표시(points_dir, zone_params)도 같은 방식으로 주행 설정 파일을 읽기만 한다
  (cobot_navigation 패키지에 의존하지 않으려고 find-pkg-share 대신 src 상대 경로를 쓴다).
-->
<launch>
  <arg name="host" default="127.0.0.1" description="웹 서버 주소 (127.0.0.1 이 PC 만, 0.0.0.0 내부망 공개)"/>
  <arg name="port" default="8080" description="웹 서버 포트 (실물 8080, 가짜 핑키 8081)"/>
  <arg name="map_yaml"
       default="$(find-pkg-share cobot_control_center)/../../../../src/cobot_navigation/map_view_pc/maps/cobot_map_v9.yaml"
       description="관제 화면 지도 YAML (로봇 amcl 과 같은 지도)"/>
  <arg name="points_dir"
       default="$(find-pkg-share cobot_control_center)/../../../../src/cobot_navigation/cobot_pinky_patrol/config"
       description="순찰 설정 폴더 (common.yaml·sites/·robots/, 또는 합친 pinkyN.yaml)"/>
  <arg name="site" default="lab" description="순찰 설정 sites/ 의 현장 이름"/>
  <arg name="zone_params"
       default="$(find-pkg-share cobot_control_center)/../../../../src/cobot_navigation/cobot_zone_traffic_control/config/zone_params.yaml"
       description="zone_manager 설정 (로봇 목록·대기 슬롯)"/>
  <arg name="node_name" default="fleet_api_node" description="노드 이름 (개발용은 fleet_api_node_dev)"/>
  <arg name="read_only" default="false" description="true 면 명령 경로 503, task_request 를 내지 않음"/>
  <arg name="web_dir" default="" description="화면 파일 폴더. 비면 설치된 share/cobot_control_center/web"/>
  <arg name="arm_command" default="true"
       description="로봇팔 명령 노드(arm_command_node)도 띄울지. 읽기 전용 개발 백엔드는 false"/>
  <arg name="net_hosts" default="real"
       description="네트워크 측정·관제 PC 상태 보고 노드: real 설정 주소(실물), local 모두 127.0.0.1(가짜 핑키·시험), off 둘 다 끔"/>

  <node pkg="cobot_control_center" exec="fleet_api_node" name="$(var node_name)" output="screen">
    <param from="$(find-pkg-share cobot_control_center)/config/fleet_api_node.yaml"/>
    <param name="host" value="$(var host)"/>
    <param name="port" value="$(var port)"/>
    <param name="map_yaml" value="$(var map_yaml)"/>
    <param name="points_dir" value="$(var points_dir)"/>
    <param name="site" value="$(var site)"/>
    <param name="zone_params" value="$(var zone_params)"/>
    <param name="read_only" value="$(var read_only)"/>
    <param name="web_dir" value="$(var web_dir)"/>
  </node>

  <!-- 웹의 로봇팔 켜기·끄기·정지를 ArmCommand 로 낸다 (/control_center/omx_N/command).
       팔 노드(Station PC cobot_manipulation)가 없으면 상태가 STALE 로 보이고 명령은 응답 없음(504). -->
  <node pkg="cobot_control_center" exec="arm_command_node" name="arm_command_node" output="screen"
        if="$(var arm_command)">
    <param from="$(find-pkg-share cobot_control_center)/config/arm_command_node.yaml"/>
  </node>

  <!-- 네트워크 측정 (화면 #/network). 핑·토픽 수신 주기만 재고 아무것도 명령하지 않는다.
       가짜 핑키·시험에서는 net_hosts:=local 로 모든 핑을 127.0.0.1 로 보낸다 (실물 장치에 핑이 가지 않게). -->
  <node pkg="cobot_control_center" exec="net_status_node" name="net_status_node" output="screen"
        if="$(eval '\'$(var net_hosts)\' == \'real\'')">
    <param from="$(find-pkg-share cobot_control_center)/config/net_status_node.yaml"/>
  </node>
  <node pkg="cobot_control_center" exec="net_status_node" name="net_status_node" output="screen"
        if="$(eval '\'$(var net_hosts)\' == \'local\'')">
    <param from="$(find-pkg-share cobot_control_center)/config/net_status_node.yaml"/>
    <param name="robot_hosts" value="[127.0.0.1, 127.0.0.1, 127.0.0.1]"/>
    <param name="station_host" value="127.0.0.1"/>
    <param name="router_host" value="127.0.0.1"/>
  </node>

  <!-- 관제 PC 자기 상태 보고 (CPU·메모리·온도·디스크). Station PC 의 host_status.launch.xml 과 같은 노드.
       측정 노드처럼 net_hosts:=off (개발 백엔드 8083) 면 띄우지 않는다 (실물 bringup 것을 같이 본다).
       패킷을 보내지 않고 이 PC 의 /proc·/sys 만 읽는다. -->
  <node pkg="cobot_control_center" exec="host_status_node" name="host_status_control" output="screen"
        if="$(eval '\'$(var net_hosts)\' != \'off\'')">
    <param from="$(find-pkg-share cobot_control_center)/config/host_status_node.yaml"/>
    <param name="host" value="control"/>
    <param name="label" value="관제 PC"/>
  </node>
</launch>
