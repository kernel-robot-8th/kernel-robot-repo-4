  Licensed under the Apache License, Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0).

  관제 작업 노드. 화면의 명령 요청을 검증·기록하고 로봇 명령 토픽(/pinkyN/patrol_cmd)에 발행한다.
  ** 실물 도메인(100)에서는 실물 로봇이 움직인다. ** 그래서 '작업 명령 꺼짐'으로 시작한다.
  cobot_bringup 의 bringup.launch.xml 이 늘 함께 띄우고, 화면 상단 '작업 명령 켜기'를 눌러야 작업 명령이 나간다.
  정지·비상정지·결과 모름 해제는 꺼져 있어도 된다. 노드가 재시작하면 다시 꺼진다.
  로봇 없이 시험할 때는 cobot_mock 의 mock_fleet.launch.xml 이 함께 띄운다 (격리 도메인 101, 켜진 상태로 시작).

  points_dir 는 fleet_api.launch.xml 처럼 src 상대 경로로 주행 설정 파일을 읽기만 한다.
-->
<launch>
  <arg name="points_dir"
       default="$(find-pkg-share cobot_control_center)/../../../../src/cobot_navigation/cobot_pinky_patrol/config"
       description="순찰 설정 폴더 (common.yaml·sites/·robots/, 또는 합친 pinkyN.yaml)"/>
  <arg name="site" default="lab" description="순찰 설정 sites/ 의 현장 이름"/>
  <arg name="db_path" default="~/.ros/cobot_control_center/tasks.db"
       description="작업 기록 SQLite 파일 (가짜 핑키는 다른 파일)"/>
  <arg name="spec_mode" default="auto" description="auto / v1 / v2"/>
  <arg name="allow_raw_cmd" default="false"
       description="개발용 수동 명령 (검사 없이 patrol_cmd 에 문자열). 실물에서는 켜지 않는다"/>
  <arg name="start_armed" default="false"
       description="작업 명령 켜진 상태로 시작할지. 실물은 false 로 두고 화면에서 켠다"/>

  <node pkg="cobot_control_center" exec="task_manager_node" name="task_manager_node" output="screen">
    <param from="$(find-pkg-share cobot_control_center)/config/task_manager_node.yaml"/>
    <param name="points_dir" value="$(var points_dir)"/>
    <param name="site" value="$(var site)"/>
    <param name="db_path" value="$(var db_path)"/>
    <param name="spec_mode" value="$(var spec_mode)"/>
    <param name="allow_raw_cmd" value="$(var allow_raw_cmd)"/>
    <param name="start_armed" value="$(var start_armed)"/>
  </node>
</launch>
