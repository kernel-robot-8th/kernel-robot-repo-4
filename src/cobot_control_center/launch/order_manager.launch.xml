  ros2 launch cobot_control_center order_manager.launch.xml
-->
<launch>
  <arg name="params_file" default="$(find-pkg-share cobot_control_center)/config/order_manager.yaml"/>
  <node pkg="cobot_control_center" exec="order_manager_node" name="order_manager" output="screen">
    <param from="$(var params_file)"/>
  </node>
</launch>
