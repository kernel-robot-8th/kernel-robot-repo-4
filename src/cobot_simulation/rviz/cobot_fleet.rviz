Panels:
- Class: rviz_common/Displays
  Help Height: 84
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    - /Arena Layout & Gate1
    - /3D Robots & Arms1
    - /Pinky 1 LiDAR (Orange)1
    Splitter Ratio: 0.5
  Tree Height: 750
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.5
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Arena Floor Grid (2.5m x 2.4m)
    Normal Cell Count: 0
    Offset:
      X: 1.25
      Y: 1.2
      Z: 0.0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: map
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Marker Scale: 0.25
    Name: TF Tree
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Value: true
  - Alpha: 0.8
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: Official Shoe Store Map (/map)
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Arena Layout & Gate
    Topic:
      Depth: 10
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /arena_markers
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: 3D Robots & Arms
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_visual_markers
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Color: 255; 140; 0
    Color Transformer: FlatColor
    Decay Time: 0.0
    Enabled: true
    Name: Pinky 1 LiDAR (Orange)
    Queue Size: 10
    Size (m): 0.04
    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /pinky1/scan
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Color: 40; 180; 99
    Color Transformer: FlatColor
    Decay Time: 0.0
    Enabled: true
    Name: Pinky 2 LiDAR (Green)
    Queue Size: 10
    Size (m): 0.04
    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /pinky2/scan
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Color: 41; 128; 185
    Color Transformer: FlatColor
    Decay Time: 0.0
    Enabled: true
    Name: Pinky 3 LiDAR (Blue)
    Queue Size: 10
    Size (m): 0.04
    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /pinky3/scan
    Use Fixed Frame: true
    Value: true
  - Class: rviz_default_plugins/Odometry
    Enabled: true
    Keep: 50
    Name: Pinky 1 Odom Path
    Shape:
      Alpha: 1.0
      Axes:
        Length: 0.25
        Radius: 0.02
      Color: 255; 140; 0
      Type: Axes
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pinky1/odom
    Value: true
  - Class: rviz_default_plugins/Odometry
    Enabled: true
    Keep: 50
    Name: Pinky 2 Odom Path
    Shape:
      Alpha: 1.0
      Axes:
        Length: 0.25
        Radius: 0.02
      Color: 40; 180; 99
      Type: Axes
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pinky2/odom
    Value: true
  - Class: rviz_default_plugins/Odometry
    Enabled: true
    Keep: 50
    Name: Pinky 3 Odom Path
    Shape:
      Alpha: 1.0
      Axes:
        Length: 0.25
        Radius: 0.02
      Color: 41; 128; 185
      Type: Axes
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pinky3/odom
    Value: true
  Global Options:
    Background Color: 30; 34; 42
    Fixed Frame: map
    Frame Rate: 30
