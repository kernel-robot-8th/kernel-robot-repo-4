  가짜 핑키 + 관제(fleet_status, fleet_api) 를 함께 띄운다. 로봇 없이 관제 화면을 시험할 때 쓴다.
  반드시 격리 도메인에서 실행한다 (실물 0·10·12·20·30·100 이면 가짜 핑키가 시작을 거부한다):
    export ROS_DOMAIN_ID=101 ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
    ros2 launch cobot_mock mock_fleet.launch.xml
  지점·구역 좌표는 실제 순찰·zone_manager 설정 파일을 그대로 읽는다.
-->
<launch>
  <arg name="points_dir" default="$(find-pkg-share cobot_pinky_patrol)/config"
       description="pinkyN.yaml 이 있는 폴더"/>
  <arg name="zone_params" default="$(find-pkg-share cobot_zone_traffic_control)/config/zone_params.yaml"
       description="zone_manager 설정 파일"/>
  <arg name="auto_patrol" default="true" description="가짜 핑키가 스스로 돌아다닐지"/>
  <arg name="with_control_center" default="true" description="fleet_status·fleet_api 도 함께 띄울지"/>

  <node pkg="cobot_mock" exec="mock_pinky_node" name="mock_pinky_node" output="screen">
    <param from="$(find-pkg-share cobot_mock)/config/mock_pinky_node.yaml"/>
    <param name="points_dir" value="$(var points_dir)"/>
    <param name="zone_params" value="$(var zone_params)"/>
    <param name="auto_patrol" value="$(var auto_patrol)"/>
  </node>

  <group if="$(var with_control_center)">
    <include file="$(find-pkg-share cobot_control_center)/launch/fleet_status.launch.xml"/>
    <include file="$(find-pkg-share cobot_control_center)/launch/fleet_api.launch.xml"/>
  </group>
</launch>
