  가짜 핑키 + 관제(fleet_status, fleet_api, 작업 노드) 를 함께 띄운다. 로봇 없이 관제 화면을 시험할 때 쓴다.
  작업 노드는 실물과 같은 fleet_control 이 기본이다. 가짜 핑키도 실물처럼 하트비트·세션·순번을 지킨다.
  예전 방식(task_manager, 다음에 제거 예정)은 controller:=task_manager.
  반드시 격리 도메인에서 실행한다 (실물 0·10·12·20·30·100 이면 가짜 핑키가 시작을 거부한다):
    export ROS_DOMAIN_ID=101 ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
    ros2 launch cobot_mock mock_fleet.launch.xml
  관제 화면은 http://localhost:8081/ 이다. 실물 관제(8080)와 한 PC 에서 함께 띄워도 포트가 겹치지 않는다.
  지점·구역 좌표는 실제 순찰·zone_manager 설정 파일을 그대로 읽는다.
-->
<launch>
  <arg name="points_dir" default="$(find-pkg-share cobot_pinky_patrol)/config"
       description="순찰 설정 폴더 (common.yaml·sites/·robots/, 또는 합친 pinkyN.yaml)"/>
  <arg name="site" default="lab" description="순찰 설정 sites/ 의 현장 이름"/>
  <arg name="zone_params" default="$(find-pkg-share cobot_zone_traffic_control)/config/zone_params.yaml"
       description="zone_manager 설정 파일"/>
  <arg name="controller" default="fleet" description="작업 노드: fleet (기본, 실물과 같음) / task_manager (예전 방식)"/>
  <arg name="auto_patrol" default="false"
       description="가짜 핑키가 스스로 돌아다닐지 (task_manager 일 때만. fleet 에서는 fleet 만 명령한다)"/>
  <arg name="dropout_robot" default="" description="주기적으로 끊기는 로봇 (끊김 화면 시험용, 기본 없음)"/>
  <arg name="with_control_center" default="true" description="fleet_status·fleet_api·작업 노드도 함께 띄울지"/>
  <arg name="port" default="8081" description="관제 화면 포트 (실물 관제 8080 과 겹치지 않게)"/>
  <arg name="spec_mode" default="auto" description="task_manager 의 명령 규격 (auto: v2 상태가 오면 v2, v1, v2)"/>
  <arg name="allow_raw_cmd" default="true" description="관제 화면의 개발용 수동 명령 칸 (가짜 핑키라 기본 켬)"/>
  <arg name="start_armed" default="true"
       description="관제 작업 명령 켜진 상태로 시작 (가짜 핑키라 기본 켬, false 면 화면에서 켬)"/>

  <node pkg="cobot_mock" exec="mock_pinky_node" name="mock_pinky_node" output="screen">
    <param from="$(find-pkg-share cobot_mock)/config/mock_pinky_node.yaml"/>
    <param name="points_dir" value="$(var points_dir)"/>
    <param name="site" value="$(var site)"/>
    <param name="zone_params" value="$(var zone_params)"/>
    <param name="auto_patrol" value="$(var auto_patrol)"/>
    <param name="dropout_robot" value="$(var dropout_robot)"/>
    <param name="central_controlled" value="$(eval '\'$(var controller)\' == \'fleet\'')"/>
  </node>

  <group if="$(var with_control_center)">
    <include file="$(find-pkg-share cobot_control_center)/launch/fleet_status.launch.xml"/>
    <include file="$(find-pkg-share cobot_control_center)/launch/fleet_api.launch.xml">
      <arg name="port" value="$(var port)"/>
    </include>
    <!-- 명령 기록은 실물과 다른 파일에 둔다 -->
    <include file="$(find-pkg-share cobot_fleet_control)/launch/fleet_control.launch.xml"
             if="$(eval '\'$(var controller)\' == \'fleet\'')">
      <arg name="patrol_config_dir" value="$(var points_dir)"/>
      <arg name="site" value="$(var site)"/>
      <arg name="db_path" value="~/.ros/cobot_control_center/fleet_mock.sqlite3"/>
      <arg name="allow_raw_cmd" value="$(var allow_raw_cmd)"/>
      <arg name="start_armed" value="$(var start_armed)"/>
    </include>
    <include file="$(find-pkg-share cobot_control_center)/launch/task_manager.launch.xml"
             if="$(eval '\'$(var controller)\' == \'task_manager\'')">
      <arg name="points_dir" value="$(var points_dir)"/>
      <arg name="db_path" value="~/.ros/cobot_control_center/tasks_mock.db"/>
      <arg name="spec_mode" value="$(var spec_mode)"/>
      <arg name="allow_raw_cmd" value="$(var allow_raw_cmd)"/>
      <arg name="start_armed" value="$(var start_armed)"/>
    </include>
  </group>
</launch>
