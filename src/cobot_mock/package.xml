<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cobot_mock</name>
  <version>0.0.0</version>
  <description>개발·시험용 가짜 핑키. 관제 PC 쪽 토픽 이름(/pinkyN/patrol_status, amcl_pose, battery, /zone_manager/status)으로 실제 순찰 노드 규격의 이벤트를 내고 /pinkyN/patrol_cmd 를 받는다. 실물 도메인(0·10·12·20·30·100)에서는 시작하지 않는다. 다른 패키지는 이 패키지에 의존하지 않으며 폴더째 빼도 된다.</description>
  <maintainer email="bebe217@gmail.com">jihye kim</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- 순찰 규격 v2 메시지 (v1 String 규격과 함께 낸다) -->
  <exec_depend>cobot_patrol_interfaces</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- 지점·구역 설정 파일만 읽는다 (코드는 import 하지 않음) -->
  <exec_depend>cobot_pinky_patrol</exec_depend>
  <exec_depend>cobot_zone_traffic_control</exec_depend>
  <!-- mock_fleet.launch.xml 이 관제 노드를 함께 띄운다 -->
  <exec_depend>cobot_control_center</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
