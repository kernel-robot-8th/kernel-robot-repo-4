<launch>
  <arg name="patrol_config_dir" default=""/>
  <arg name="site" default="lab"/>
  <arg name="db_path" default="~/.cobot/fleet_control.sqlite3"
       description="실행 원장 SQLite (가짜 핑키·가제보는 다른 파일)"/>
  <arg name="allow_raw_cmd" default="false"
       description="개발용 수동 명령. 실물에서는 켜지 않는다"/>
  <arg name="start_armed" default="false"
       description="작업 명령 켜진 상태로 시작. 격리 도메인 시뮬 전용"/>
  <!-- 관제 PC의 기존 도메인 100에서 실행한다. -->
  <node pkg="cobot_fleet_control" exec="fleet_control_node" name="fleet_control" output="screen">
    <param from="$(find-pkg-share cobot_fleet_control)/config/fleet_control.yaml"/>
    <param name="patrol_config_dir" value="$(var patrol_config_dir)" type="str"/>
    <param name="site" value="$(var site)" type="str"/>
    <param name="db_path" value="$(var db_path)" type="str"/>
    <param name="allow_raw_cmd" value="$(var allow_raw_cmd)"/>
    <param name="start_armed" value="$(var start_armed)"/>
  </node>
</launch>
